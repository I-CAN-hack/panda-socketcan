 * board/boards/white.h and board/stm32f4/{clock,peripherals}.h.
 */

#include <st/f4/stm32f413Xg.dtsi>
#include <st/f4/stm32f413r(g-h)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,canbus = &can1;
	};

	leds {
		compatible = "gpio-leds";
		red_led: red {
			gpios = <&gpioc 9 GPIO_ACTIVE_LOW>;
		};
		green_led: green {
			gpios = <&gpioc 7 GPIO_ACTIVE_LOW>;
		};
		blue_led: blue {
			gpios = <&gpioc 6 GPIO_ACTIVE_LOW>;
		};
	};

	can1_phy: can1-phy {
		compatible = "can-transceiver-gpio";
		#phy-cells = <0>;
		max-bitrate = <1000000>;
		standby-gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
	};
	can2_phy: can2-phy {
		compatible = "can-transceiver-gpio";
		#phy-cells = <0>;
		max-bitrate = <1000000>;
		standby-gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
	};
	can3_phy: can3-phy {
		compatible = "can-transceiver-gpio";
		#phy-cells = <0>;
		max-bitrate = <1000000>;
		standby-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

&pll {
	div-m = <8>;
	mul-n = <96>;
	div-p = <2>;
	div-q = <4>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(96)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <2>;
};

&can1 {
	pinctrl-0 = <&can1_rx_pb8 &can1_tx_pb9>;
	pinctrl-names = "default";
	phys = <&can1_phy>;
	status = "okay";
};

&can2 {
	pinctrl-0 = <&can2_rx_pb5 &can2_tx_pb6>;
	pinctrl-names = "default";
	phys = <&can2_phy>;
	status = "okay";
};

&can3 {
	pinctrl-0 = <&can3_rx_pa8 &can3_tx_pa15>;
	pinctrl-names = "default";
	phys = <&can3_phy>;
	status = "okay";
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

&usb_otg_fs_dm_pa11 {
	slew-rate = "very-high-speed";
};

&usb_otg_fs_dp_pa12 {
	slew-rate = "very-high-speed";
};

